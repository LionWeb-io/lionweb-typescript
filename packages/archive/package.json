{
    "name": "@lionweb/archive",
    "version": "0.10.0",
    "description": "Support for loading and storing LionWeb Archives",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LionWeb-io/lionweb-typescript.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-typescript/issues"
    },
    "scripts": {
        "clean": "npx rimraf dist node_modules -g lionweb-archive-*.tgz",
        "build": "npx rimraf dist && tsc",
        "lint": "eslint src",
        "prep:pre-release": "npm run clean && npm install && npm run build",
        "prerelease-alpha": "npm run prep:pre-release",
        "release-alpha": "npm publish --tag alpha",
        "prerelease-beta": "npm run prep:pre-release",
        "release-beta": "npm publish --tag beta",
        "prerelease": "npm run prep:pre-release",
        "release": "npm publish"
    },
    "dependencies": {
        "@bufbuild/protobuf": "2.16.0",
        "@lionweb/json": "0.10.0",
        "jszip": "3.10.2"
    },
    "devDependencies": {
        "@types/chai": "5.2.3",
        "@types/mocha": "10.0.10",
        "chai": "6.2.2",
        "mocha": "11.7.5"
    }
}
